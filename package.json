{
  "name": "claude-usage-monitor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test": "node --test",
    "start": "node server.mjs",
    "app": "electron .",
    "dist": "electron-builder --mac",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "main": "app/main.js",
  "build": {
    "appId": "com.ntm.claude-usage-monitor",
    "productName": "Claude Usage Monitor",
    "files": [
      "app/**",
      "src/**",
      "public/**",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    }
  }
}
